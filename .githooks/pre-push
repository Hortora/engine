#!/usr/bin/env python3
"""pre-push hook: a base branch stays linear and is never rewritten.

It checks only what can be decided from the commits being pushed:

  - a push to main or master must not add a merge commit;
  - a push to main or master must be a fast-forward of what the remote has
    (so a forced push that would rewrite published history is refused);
  - main or master is never deleted on a remote.

It does not judge commit messages or guess at "squash candidates". Whether a
branch's history is fit to land is the squash review's job, recorded in
refs/squash-reviewed/<branch> and enforced by work-end/close.py before anything
reaches a base branch. By the time commits are pushed they have passed it.

Pushes to any other ref are not this hook's business.

git calls this as: pre-push <remote-name> <remote-url>, with one line per ref on
stdin: <local ref> <local sha> <remote ref> <remote sha>. A non-zero exit
refuses the push. Any failure inside the hook lets the push through: a broken
guard must not stop work, and the remote still refuses a non-fast-forward.
"""
import subprocess
import sys

BASE_REFS = ("refs/heads/main", "refs/heads/master")
ZERO = "0" * 40


def git(*args):
    result = subprocess.run(["git", *args], capture_output=True, text=True)
    return result.returncode, result.stdout.strip()


def refuse(lines):
    print("", file=sys.stderr)
    for line in lines:
        print(f"pre-push: {line}", file=sys.stderr)
    print("", file=sys.stderr)
    return 1


def main():
    remote = sys.argv[1] if len(sys.argv) > 1 else "origin"
    for line in sys.stdin:
        parts = line.split()
        if len(parts) != 4:
            continue
        _local_ref, local_sha, remote_ref, remote_sha = parts
        if remote_ref not in BASE_REFS:
            continue
        branch = remote_ref[len("refs/heads/"):]

        if set(local_sha) == {"0"}:
            return refuse([f"refusing to delete {branch} on {remote}."])

        if set(remote_sha) != {"0"}:
            code, _ = git("merge-base", "--is-ancestor", remote_sha, local_sha)
            if code == 1:
                return refuse([
                    f"this would rewrite {branch} on {remote}: what it has now is not part of",
                    "what you are pushing. A base branch only ever fast-forwards.",
                    "Bring the remote's commits in first:",
                    "  python3 ~/.claude/skills/project/canonical_sync.py publish <repo>",
                ])
            if code != 0:
                continue                    # the remote's commit is unknown here; let git decide
            new_commits = f"{remote_sha}..{local_sha}"
            code, merges = git("rev-list", "--merges", new_commits)
        else:
            # A new branch on the remote: everything it does not already have.
            code, merges = git("rev-list", "--merges", local_sha, "--not", f"--remotes={remote}")
        if code != 0 or not merges:
            continue
        shown = []
        for sha in merges.splitlines()[:5]:
            _, subject = git("log", "-1", "--format=%h %s", sha)
            shown.append(f"  {subject}")
        count = len(merges.splitlines())
        return refuse([
            f"{count} merge commit(s) would be added to {branch} on {remote}:",
            *shown,
            "A base branch is linear. Land work with `work end`, which rebases and",
            "fast-forwards, instead of merging into the base branch.",
        ])
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)
